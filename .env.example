# FloodLens AI Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Backend ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://floodlens:floodlens@localhost:5432/floodlens
SYNC_DATABASE_URL=postgresql://floodlens:floodlens@localhost:5432/floodlens
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# ─── Open-Meteo (free, no key required) ─────────────────────
# Open-Meteo is used for weather forecasts. No API key needed for the free tier.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ─── Optional: Supabase (PostgreSQL/PostGIS in the cloud) ───
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Optional: Cloudflare R2 (artifact storage) ─────────────
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET_NAME=floodlens-artifacts
# R2_PUBLIC_URL=https://your-bucket.r2.dev

# ─── Optional: LLM (Ask FloodLens assistant) ─────────────────
# LLM_PROVIDER=gemini             # gemini | openai | anthropic
# GEMINI_API_KEY=your-key
# OPENAI_API_KEY=your-key
# ANTHROPIC_API_KEY=your-key

# ─── Optional: Copernicus / ESA STAC (Sentinel-1) ────────────
# COPERNICUS_USER=your-username
# COPERNICUS_PASSWORD=your-password

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_APP_ENV=development

# ─── Optional: Copernicus Data Space (Sentinel-1/2 imagery) ─
# Create an OAuth client at https://shapps.dataspace.copernicus.eu/dashboard/ (Sentinel Hub > OAuth clients).
# Scene search works without these; imagery rendering needs them. Backend only.
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=

# ─── Optional: Google Earth Engine (flood analysis) ─────────
# EE_PROJECT_ID=your-gcp-project-id
# EE_SERVICE_ACCOUNT=name@project.iam.gserviceaccount.com   # optional; else `earthengine authenticate`
# EE_PRIVATE_KEY_FILE=/secure/path/key.json                  # never commit; backend only
# ANALYSIS_DB_PATH=data/analysis_runs.sqlite
# EXPERIMENT_DIR=artifacts/experiments
